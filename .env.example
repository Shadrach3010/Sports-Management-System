# Public values safe to expose to browser code. Obtain these from Supabase's
# project Connect dialog. Do not place secret/service_role keys in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional local-only Playwright acceptance-test identities. Provision these
# synthetic accounts and roles in a disposable Supabase project. Never use
# production accounts or commit real passwords.
E2E_EVENT_ID=00000000-0000-0000-0000-000000000000
E2E_JUDGE_EMAIL=judge-e2e@example.invalid
E2E_JUDGE_PASSWORD=replace-with-local-test-password
E2E_VERIFIER_EMAIL=verifier-e2e@example.invalid
E2E_VERIFIER_PASSWORD=replace-with-local-test-password
E2E_COORDINATOR_EMAIL=coordinator-e2e@example.invalid
E2E_COORDINATOR_PASSWORD=replace-with-local-test-password
